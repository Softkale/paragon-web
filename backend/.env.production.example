# Copia este archivo a backend/.env en el servidor y completa los valores.
# Nunca subas el .env real al repositorio.

NODE_ENV=production
PORT=4000
# Solo escucha en la máquina: nginx es quien recibe el tráfico de internet.
HOST=127.0.0.1
# Detrás de nginx: así se ve la IP real de cada visitante (límites de intentos).
TRUST_PROXY=1

# Si la contraseña tiene símbolos (@ : / # $ %), codifícalos (ej. @ -> %40).
DATABASE_URL=postgres://paragon:CAMBIA_ESTA_CLAVE@localhost:5432/paragon

# Mínimo 32 caracteres. Genéralo con:  openssl rand -hex 48
# Si lo cambias después, se cierran todas las sesiones y hay que volver a escribir la contraseña del SMTP en el panel.
JWT_SECRET=

# Opcional: el SMTP y la dirección pública de la web se configuran desde el panel (Configuración).
# Solo si quieres dejarlos fijos aquí:
# APP_URL=https://paragon.tudominio.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="PARAGON <no-reply@tudominio.com>"
