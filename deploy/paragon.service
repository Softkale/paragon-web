# /etc/systemd/system/paragon.service
# Ajusta User y las rutas si instalas en otro lugar.
[Unit]
Description=PARAGON (web + API)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=paragon
WorkingDirectory=/opt/paragon/backend
EnvironmentFile=/opt/paragon/backend/.env
ExecStart=/usr/bin/node src/server.js
# El "+" lo ejecuta como root: si el puerto 4000 estaba ocupado, ajusta nginx al puerto real.
ExecStartPost=+/opt/paragon/deploy/sync-nginx-port.sh
Restart=always
RestartSec=3

# Endurecimiento básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/paragon/backend/outbox

[Install]
WantedBy=multi-user.target
